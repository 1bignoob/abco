---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { createContactPageSchema } from '../lib/schema';

const contactSchema = createContactPageSchema();
---

<BaseLayout
  title="Contact ABCO Landscaping & Construction | Free Estimates in Eagle Lake, PA"
  description="Contact ABCO Landscaping & Construction for landscaping, excavation, and property maintenance estimates in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/contact/"
  schemaJson={contactSchema}
>

  <div class="page-header">
    <div class="container">
      <h1>Contact ABCO Landscaping &amp; Construction for a Free Estimate</h1>
      <p>We'd love to hear from you. Fill out the form below or call us directly.</p>
    </div>
  </div>

  <ContactSection />

</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-dark) 100%);
    border-bottom: 1px solid var(--color-border);
    padding-block: 3rem 2.5rem;
  }
  .page-header h1 { margin-bottom: 0.4rem; }
  .page-header p { color: var(--color-text-muted); font-size: 1.1rem; }
</style>
