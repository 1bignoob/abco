---
// ─── blog/[slug].astro ─────────────────────────────────────────────────────
// Individual blog post page — outputs to abcoguys.com/blog/[post-filename]/
//
// getStaticPaths() runs at build time: it reads every .md file from the
// blog collection and generates one page per post. The file name (without .md)
// becomes the URL slug automatically.
//
// `render(post)` turns the Markdown body into an Astro <Content /> component
// which is dropped into the .prose wrapper below.
//
// SCHEMA: createBlogPostSchema() generates BlogPosting structured data
// including author, tags, and publish date.
//
// TO ADD A NEW POST: just drop a new .md in src/content/blog/ — no code changes needed.
// ─────────────────────────────────────────────────────────────────────────────
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { createBlogPostSchema } from '../../lib/schema';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postSchema = createBlogPostSchema({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDateIso: post.data.pubDate.toISOString(),
  author: post.data.author,
  tags: post.data.tags,
});

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

---

<BaseLayout
  title={`${post.data.title} | ABCO Landscaping & Construction`}
  description={post.data.description}
  canonical={`/blog/${post.id}/`}
  ogType="article"
  schemaJson={postSchema}
>

  <article class="blog-post">

    <!-- Post header -->
    <header class="post-header">
      <div class="container post-header-inner">

        <h1>{post.data.title}</h1>

        <div class="post-byline">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.author && (
            <span>by {post.data.author}</span>
          )}
          {post.data.tags && (
            <div class="post-tags" aria-label="Tags">
              {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
        </div>

      </div>
    </header>

    <!-- Post content -->
    <div class="post-body">
      <div class="container">
        <div class="prose">
          <Content />
        </div>

        <!-- End-of-article CTA -->
        <aside class="post-cta" aria-label="Contact prompt">
          <p>
            <strong>Ready to put this into action?</strong> ABCO Landscaping serves Eagle Lake,
            Gouldsboro, and Covington Township PA.
            <a href={`${base}contact`} title="Contact ABCO for a free estimate">Contact us for a free estimate.</a>
          </p>
        </aside>

        <!-- Nav between posts -->
        <div class="back-link">
          <a href={`${base}blog`} title="Back to the ABCO blog">← Back to All Articles</a>
        </div>
      </div>
    </div>

  </article>

</BaseLayout>

<style>
  /* Post header */
  .post-header {
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
    padding-block: 3rem 2.5rem;
  }

  .post-header-inner { max-width: 860px; }

  /* Breadcrumb */
  .breadcrumb { margin-bottom: 1.25rem; }
  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    font-size: 0.9rem;
  }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--color-orange); }
  .breadcrumb li[aria-current="page"] { color: var(--color-orange); font-weight: 600; }
  .breadcrumb li[aria-hidden="true"] { color: var(--color-border-input); }

  .post-header h1 {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .post-byline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--color-text-dim);
    font-size: 0.95rem;
  }

  .post-byline time,
  .post-byline span { color: var(--color-text-dim); }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: rgba(217, 82, 16, 0.12);
    color: var(--color-orange);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 3px;
  }

  /* Body */
  .post-body {
    background: var(--color-bg);
    padding-block: 3.5rem;
  }

  .post-body .container { max-width: 860px; }

  /* End-of-post CTA box */
  .post-cta {
    margin-top: 3rem;
    padding: 1.5rem 2rem;
    background: rgba(217, 82, 16, 0.08);
    border-left: 4px solid var(--color-orange);
    border-radius: 0 8px 8px 0;
  }

  .post-cta p {
    color: var(--color-text-light);
    font-size: 1.1rem;
    max-width: none;
  }

  .post-cta strong { color: var(--color-white); }

  .post-cta a { color: var(--color-orange); font-weight: 700; }
  .post-cta a:hover { color: var(--color-orange-hov); }

  .back-link {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-sub);
  }

  .back-link a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .back-link a:hover { color: var(--color-orange); }
</style>
