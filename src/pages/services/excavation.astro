---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';
import { createServicePageSchema } from '../../lib/schema';

const excavationSchema = createServicePageSchema({
  slug: 'excavation',
  name: 'Excavation Services in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Excavation, grading, site clearing, driveway prep, foundation excavation, drainage work, and fill placement for projects in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Excavation',
});
---

<BaseLayout
  title="Excavation Services in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Professional excavation, grading, site clearing, and land prep services in Eagle Lake, Gouldsboro, and Covington Township, PA. Free estimates available."
  canonical="/services/excavation/"
  image="/images/heros/excavation-hero.webp"
  imageAlt="ABCO excavation equipment on a jobsite near Gouldsboro and Eagle Lake, PA"
  schemaJson={excavationSchema}
>
  <ServiceDetailTemplate
    heroTitle="Excavation Services in Eagle Lake, Gouldsboro & Covington Township, PA"
    heroIntro="Covington Township, Eagle Lake & Gouldsboro, PA"
    heroImageSrc="/images/heros/excavation-hero.webp"
    heroImageMobileSrc="/images/heros/excavation-hero-mobile.webp"
    heroImageObjectPosition="80% 38%"
    heroImageAlt="ABCO excavation equipment on a jobsite near Gouldsboro and Eagle Lake, PA"
    servicesHeading="What Our Excavation Company Handles"
    servicesIntro="ABCO handles excavation projects of all sizes, from a single driveway to full site clearing and land prep for construction in Covington Township, Eagle Lake, Gouldsboro, and nearby areas."
    servicesOffered={[
      'Site clearing and land grading',
      'Driveway excavation and preparation',
      'Foundation excavation',
      'Drainage correction and French drains',
      'Topsoil removal and fill placement',
      'Stump and root removal',
      'Resurfacing and final grading',
    ]}
    secondaryHeading="Our Excavation Process"
    secondaryParagraphs={[
      'Every job starts with a site walk and a free estimate. We call 811 before digging and plan around utility marking and safe equipment access.',
      'You get a clear work scope, schedule, and cleanup plan before any excavation starts.',
    ]}
    factsHeading="Excavation Service Facts"
    facts={[
      'Residential and commercial',
      'All project sizes welcome',
      'Free estimates',
      'Mon-Fri 8 AM - 6 PM',
      'Sat 9:30 AM - 4:30 PM',
    ]}
    sidebarCtaPrompt="Ready to get started?"
    sidebarCtaLabel="Call (718) 877-1197"
    relatedServices={[
      { slug: 'landscaping', label: 'Landscaping', title: 'View landscaping services' },
      { slug: 'property-maintenance', label: 'Property Maintenance', title: 'View property maintenance services' },
    ]}
    didYouKnowIntro="Excavation quality depends on planning and site conditions before the first bucket hits the ground."
    didYouKnowItems={[
      {
        title: 'Utility marking is non-negotiable',
        body: 'Safe excavation begins with underground utility identification and equipment routing before work starts.',
      },
      {
        title: 'Drainage drives long-term performance',
        body: 'Grading and runoff direction are just as important as digging depth for long-lasting results.',
      },
      {
        title: 'Compaction matters after placement',
        body: 'Fill and base materials need proper placement and compaction to avoid settling and rework.',
      },
    ]}
    faqHeading="Excavation FAQ"
    faqItems={[
      {
        kicker: 'Scope',
        question: 'Do you handle small excavation jobs?',
        answer: 'Yes. We handle both small and large excavation work, including driveway prep and localized grading corrections.',
      },
      {
        kicker: 'Safety',
        question: 'Do you coordinate utility marking?',
        answer: 'Yes. We follow utility-marking requirements before excavation so the work can be done safely.',
      },
      {
        kicker: 'Scheduling',
        question: 'Can I get a free estimate first?',
        answer: 'Yes. Every project starts with a site review and a free estimate with clear scope and timeline.',
      },
    ]}
    listMarker="check"
  />
</BaseLayout>
