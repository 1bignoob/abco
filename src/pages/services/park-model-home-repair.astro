---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';
import { createServicePageSchema } from '../../lib/schema';

const parkModelRepairSchema = createServicePageSchema({
  slug: 'park-model-home-repair',
  name: 'Park Model Home Repair in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Exterior and site-focused repair support for park model homes, including structural touchups and property maintenance coordination in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Park Model Home Repair',
});
---

<BaseLayout
  title="Park Model Home Repair in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Specialized repair and maintenance support for park model homes and surrounding property areas in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/park-model-home-repair/"
  image="/images/heros/google-review-hero.webp"
  imageAlt="ABCO Landscaping and Construction project scene in the Eagle Lake, PA area"
  schemaJson={parkModelRepairSchema}
>
  <ServiceDetailTemplate
    heroTitle="Park Model Home Repair in Eagle Lake, Gouldsboro & Covington Township, PA"
    heroIntro="Eagle Lake, Gouldsboro & Covington Township, PA"
    heroImageSrc="/images/heros/google-review-hero.webp"
    heroImageAlt="ABCO Landscaping and Construction project scene in the Eagle Lake, PA area"
    servicesHeading="Park Model Home Repair Services"
    servicesIntro="ABCO provides practical repair support for park model homes and surrounding site conditions with a focus on durable fixes and clean execution."
    servicesOffered={[
      'Exterior repair and adjustment support',
      'Deck and entry area maintenance',
      'Site drainage and grading corrections',
      'Seasonal wear and weather damage fixes',
      'General property safety improvements',
      'Coordinated maintenance planning',
    ]}
    secondaryHeading="Built for Seasonal Property Needs"
    secondaryParagraphs={[
      'Park model homes need targeted maintenance across changing weather and occupancy schedules.',
      'We tailor repair planning to access, usage patterns, and site conditions.',
    ]}
    factsHeading="Park Model Repair Facts"
    facts={[
      'Specialized seasonal support',
      'Exterior and site-focused work',
      'Custom repair planning',
      'Mon-Fri 8 AM - 6 PM',
      'Sat 9:30 AM - 4:30 PM',
    ]}
    sidebarCtaPrompt="Need park model repairs?"
    relatedServices={[
      { slug: 'property-maintenance', label: 'Property Maintenance', title: 'View property maintenance services' },
      { slug: 'winterizing', label: 'Winterizing', title: 'View winterizing services' },
    ]}
    didYouKnowIntro="Park model homes often need a maintenance strategy that matches both seasonal weather and occupancy cycles."
    didYouKnowItems={[
      {
        title: 'Seasonal timing matters',
        body: 'Inspection and repairs done before weather shifts can prevent larger cold-season issues.',
      },
      {
        title: 'Site conditions affect wear',
        body: 'Drainage and surrounding grade can directly impact long-term exterior condition and safety.',
      },
      {
        title: 'Small fixes prevent larger work',
        body: 'Routine adjustments and minor repairs reduce the chance of larger structural or access problems.',
      },
    ]}
    faqHeading="Park Model Repair FAQ"
    faqItems={[
      {
        kicker: 'Coverage',
        question: 'Do you handle exterior and entry-area repairs?',
        answer: 'Yes. We support exterior repair needs, entry areas, and surrounding site condition issues.',
      },
      {
        kicker: 'Planning',
        question: 'Can repairs be planned around seasonal occupancy?',
        answer: 'Yes. We can align repair timing and scope with your seasonal use schedule.',
      },
      {
        kicker: 'Site Work',
        question: 'Do you address grading or drainage concerns too?',
        answer: 'Yes. Site drainage and grade corrections can be part of the repair plan when needed.',
      },
    ]}
  />
</BaseLayout>
