---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';
import { createServicePageSchema } from '../../lib/schema';

const seasonalCleanupSchema = createServicePageSchema({
  slug: 'seasonal-cleanup',
  name: 'Seasonal Cleanup Services in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Spring and fall property cleanup including leaf removal, bed clearing, trimming, and debris hauling in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Seasonal Cleanup',
});
---

<BaseLayout
  title="Seasonal Cleanup Services in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Spring and fall cleanup services that keep your property clean, safe, and ready for the next season in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/seasonal-cleanup/"
  image="/images/heros/seasonal-cleanup-hero.webp"
  imageAlt="Seasonal property cleanup service in Eagle Lake and Gouldsboro, PA"
  schemaJson={seasonalCleanupSchema}
>
  <ServiceDetailTemplate
    heroTitle="Seasonal Cleanup Services in Eagle Lake, Gouldsboro & Covington Township, PA"
    heroIntro="Eagle Lake, Gouldsboro & Covington Township, PA"
    heroImageSrc="/images/heros/seasonal-cleanup-hero.webp"
    heroImageMobileSrc="/images/heros/seasonal-cleanup-hero-mobile.webp"
    heroImageAlt="Seasonal property cleanup service in Eagle Lake and Gouldsboro, PA"
    servicesHeading="What Is Included in Seasonal Cleanup"
    servicesIntro="ABCO handles spring and fall cleanup work that restores curb appeal and helps prevent weather-related issues before each season shift."
    servicesOffered={[
      'Leaf and debris removal',
      'Flower bed and edge cleanup',
      'Shrub and branch trimming',
      'Yard waste hauling',
      'Storm cleanup support',
      'Season transition prep',
    ]}
    secondaryHeading="Spring and Fall Planning"
    secondaryParagraphs={[
      'We can schedule one-time cleanup visits or recurring annual seasonal service based on your property needs.',
      'Advance scheduling helps ensure your site is ready before major weather changes.',
    ]}
    factsHeading="Seasonal Cleanup Facts"
    facts={[
      'Spring and fall scheduling',
      'Debris hauling included',
      'Residential and commercial',
      'Mon-Fri 8 AM - 6 PM',
      'Sat 9:30 AM - 4:30 PM',
    ]}
    sidebarCtaPrompt="Need seasonal cleanup support?"
    relatedServices={[
      { slug: 'landscaping', label: 'Landscaping', title: 'View landscaping services' },
      { slug: 'property-maintenance', label: 'Property Maintenance', title: 'View property maintenance services' },
    ]}
    didYouKnowIntro="Seasonal cleanup is one of the easiest ways to protect curb appeal and avoid deferred maintenance issues."
    didYouKnowItems={[
      {
        title: 'Fall cleanup reduces spring backlog',
        body: 'Clearing leaves and debris before winter helps properties dry out and green up faster in spring.',
      },
      {
        title: 'Bed cleanup supports healthier growth',
        body: 'Removing dead material and buildup helps air flow and makes seasonal planting easier.',
      },
      {
        title: 'Timing improves results',
        body: 'Cleanup done at the right point in the season is more effective than waiting for weather extremes.',
      },
    ]}
    faqHeading="Seasonal Cleanup FAQ"
    faqItems={[
      {
        kicker: 'Scheduling',
        question: 'Do you offer spring and fall cleanup?',
        answer: 'Yes. We provide both spring and fall cleanup scheduling for homes and commercial sites.',
      },
      {
        kicker: 'Scope',
        question: 'Is debris hauling included?',
        answer: 'Yes. Debris and yard-waste hauling are included in the cleanup scope.',
      },
      {
        kicker: 'Service Type',
        question: 'Can this be one-time or recurring?',
        answer: 'Both. We can schedule one-time cleanup or recurring seasonal visits each year.',
      },
    ]}
  />
</BaseLayout>
