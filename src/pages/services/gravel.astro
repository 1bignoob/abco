---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';
import { createServicePageSchema } from '../../lib/schema';

const gravelSchema = createServicePageSchema({
  slug: 'gravel',
  name: 'Gravel Delivery and Spreading in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Bulk gravel delivery, driveway base prep, grading, and spreading services for properties in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Gravel Delivery and Spreading',
});
---

<BaseLayout
  title="Gravel Delivery and Spreading in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Gravel delivery and site prep for driveways, access roads, and pad areas in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/gravel/"
  image="/images/heros/excavation-hero.webp"
  imageAlt="ABCO excavation equipment on a gravel preparation project near Gouldsboro and Eagle Lake, PA"
  schemaJson={gravelSchema}
>
  <ServiceDetailTemplate
    heroTitle="Gravel Delivery and Spreading in Eagle Lake, Gouldsboro & Covington Township, PA"
    heroIntro="Eagle Lake, Gouldsboro & Covington Township, PA"
    heroImageSrc="/images/heros/excavation-hero.webp"
    heroImageAlt="ABCO excavation equipment on a gravel preparation project near Gouldsboro and Eagle Lake, PA"
    servicesHeading="What Our Gravel Service Covers"
    servicesIntro="ABCO delivers and spreads gravel for driveways, parking areas, access lanes, and utility pads, with base prep and grading for proper drainage and durability."
    servicesOffered={[
      'Driveway gravel refresh and new installs',
      'Base preparation and compaction',
      'Delivery and spreading',
      'Final grading and crown shaping',
      'Erosion and washout correction',
      'Residential and commercial service',
    ]}
    secondaryHeading="Proper Base and Drainage"
    secondaryParagraphs={[
      'A durable gravel surface starts with the right base and grade. We evaluate slope, runoff, and usage before recommending material depth.',
      'Final shaping and compaction help keep the surface stable and easier to maintain over time.',
    ]}
    factsHeading="Gravel Service Facts"
    facts={[
      'Delivery and spreading',
      'Grading included',
      'Driveways and access roads',
      'Mon-Fri 8 AM - 6 PM',
      'Sat 9:30 AM - 4:30 PM',
    ]}
    sidebarCtaPrompt="Need driveway gravel work?"
    relatedServices={[
      { slug: 'excavation', label: 'Excavation', title: 'View excavation services' },
      { slug: 'property-maintenance', label: 'Property Maintenance', title: 'View property maintenance services' },
    ]}
    didYouKnowIntro="Most gravel surface failures are caused by poor base prep and drainage, not just material quality."
    didYouKnowItems={[
      {
        title: 'Crown and runoff direction matter',
        body: 'A properly shaped surface helps move water off the drive and reduces washouts and rutting.',
      },
      {
        title: 'Compaction extends surface life',
        body: 'Layer placement and compaction are key to limiting settling and reducing future maintenance.',
      },
      {
        title: 'Material depth should match usage',
        body: 'Vehicle type, traffic frequency, and slope all influence how much base and top material is needed.',
      },
    ]}
    faqHeading="Gravel Service FAQ"
    faqItems={[
      {
        kicker: 'Coverage',
        question: 'Do you handle new gravel installs and refreshes?',
        answer: 'Yes. We handle both new installations and gravel surface refresh projects.',
      },
      {
        kicker: 'Prep',
        question: 'Do you prep the base before spreading gravel?',
        answer: 'Yes. Base preparation and grading are included to help with drainage and longevity.',
      },
      {
        kicker: 'Use Cases',
        question: 'Can you service access roads and pads too?',
        answer: 'Yes. We work on driveways, access lanes, parking areas, and utility pad spaces.',
      },
    ]}
  />
</BaseLayout>
