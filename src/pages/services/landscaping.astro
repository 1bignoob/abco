---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';
import { createServicePageSchema } from '../../lib/schema';

const landscapingSchema = createServicePageSchema({
  slug: 'landscaping',
  name: 'Landscaping Services in Gouldsboro, PA | Lawn Care, Mulch, Planting & Weed Control',
  description:
    'ABCO Landscaping provides lawn mowing, weed control, mulch installation, planting, and landscape maintenance in Gouldsboro, Eagle Lake Community, and nearby Northeast PA areas.',
  serviceType: 'Landscaping',
});
---

<BaseLayout
  title="Landscaping Services in Gouldsboro, PA | Lawn Care and Beautification"
  description="ABCO Landscaping provides lawn mowing and maintenance, weed control, mulch, planting in Gouldsboro, Eagle Lake, and nearby Pocono areas."
  canonical="/services/landscaping/"
  image="/images/heros/landscaping-hero.webp"
  imageAlt="ABCO Landscaping displaying a well maintained landscaping property in Gouldsboro, PA"
  schemaJson={landscapingSchema}
>
  <ServiceDetailTemplate
    heroTitle="Landscaping Services in Gouldsboro, PA"
    heroIntro="ABCO Landscaping provides reliable lawn mowing, weed control, mulch installation, planting, and landscape maintenance for properties in Gouldsboro, Eagle Lake, Covington Township, and nearby Pocono communities."
    heroImageSrc="/images/heros/landscaping-hero.webp"
    heroImageMobileSrc="/images/heros/landscaping-hero-mobile.webp"
    heroImageObjectPosition="90% 38%"
    heroImageAlt="ABCO Landscaping displaying a well maintained landscaping property in Gouldsboro, PA"
    servicesHeading="Lawn Care and Maintenance"
    servicesIntro="A great-looking property starts with consistent lawn and landscape care. We focus on clean mowing, neat edges, controlled weeds, healthy beds, and refreshed materials."
    servicesOffered={[
      'Lawn mowing',
      'Weed control',
      'Mulch installation',
      'Planting',
      'Landscape bed refreshes',
      'Lawn care materials',
      'Decorative stone, soil, and mulch placement',
      'Basic property beautification',
    ]}
    secondaryHeading="Practical Landscaping for Pocono Conditions"
    secondaryParagraphs={[
      'Plant choice and maintenance plans should reflect deer pressure, shade, rocky soil, wet spots, and winter cycles common in Northeast PA.',
      'We can support one-time upgrades or recurring maintenance based on your property priorities.',
    ]}
    richHtmlBlocks={[
      {
        heading: 'Lawn Mowing',
        html: '<p>Regular mowing keeps your property maintained and easier to manage throughout the season. We provide mowing for homes, vacation properties, rentals, and small commercial lots, including trimming around walkways, edges, and structures for a clean finish.</p>',
      },
      {
        heading: 'Weed Control',
        html: '<p>Weeds can quickly overtake lawns, beds, and hardscape edges. ABCO helps control weeds in lawn areas, mulch beds, planting beds, walkway edges, and hard-to-maintain zones around structures. For many properties in the Poconos, consistent maintenance is more effective than waiting until weeds are already out of control.</p>',
      },
      {
        heading: 'Mulching',
        html: '<p>Fresh mulch is one of the fastest ways to improve curb appeal. We install mulch around trees, shrubs, flower beds, and walkways to create a finished look, reduce weed growth, and help soil retain moisture.</p>',
      },
      {
        heading: 'Planting',
        html: '<p>We help with practical planting for front beds, borders, walkways, and entry areas. For Pocono properties, plant choice matters because deer pressure, shade, rocky soil, wet spots, and cold winters all affect long-term success.</p>',
      },
      {
        heading: 'Lawn Care Materials',
        html: '<p>We refresh common landscape materials including mulch, topsoil, decorative stone, and planting soil. Using the right material in the right location helps reduce upkeep and keeps your property cleaner between visits.</p><p>Need regular upkeep? We can set a practical service rhythm that keeps your property clean and usable without over-maintenance.</p>',
      },
    ]}
    factsHeading="Landscaping Service Facts"
    facts={[
      'Residential and small commercial',
      'Recurring and one-time options',
      'Mulch, planting, and lawn care',
      'Mon-Fri 8 AM - 6 PM',
      'Sat 9:30 AM - 4:30 PM',
    ]}
    sidebarCtaPrompt="Need landscaping help this season?"
    relatedServices={[
      { slug: 'property-maintenance', label: 'Property Maintenance', title: 'View property maintenance services' },
      { slug: 'seasonal-cleanup', label: 'Seasonal Cleanup', title: 'View seasonal cleanup services' },
    ]}
    didYouKnowIntro="Gouldsboro and nearby Pocono properties often need landscaping plans tailored to climate and site pressure."
    didYouKnowItems={[
      {
        title: 'Deer-resistant is not deer-proof',
        body: 'Plant performance can change by season and browsing pressure, so protection may still be needed.',
      },
      {
        title: 'Mulch depth affects plant health',
        body: 'Even, moderate mulch layers generally perform better than heavy mounds around stems and trunks.',
      },
      {
        title: 'Low-maintenance still needs maintenance',
        body: 'Good material choices reduce upkeep, but trimming, cleanup, and refreshes are still required.',
      },
    ]}
    faqHeading="Landscaping FAQ"
    faqItems={[
      {
        kicker: 'Services',
        question: 'What landscaping services do you offer?',
        answer: 'We offer mowing, weed control, planting, mulch, and basic landscape maintenance for multiple property types.',
      },
      {
        kicker: 'Scheduling',
        question: 'Do you offer recurring lawn mowing?',
        answer: 'Yes. We offer recurring mowing and maintenance schedules based on property and seasonal needs.',
      },
      {
        kicker: 'Planting',
        question: 'Can you help with practical plant selection?',
        answer: 'Yes. We can suggest options based on local site conditions and maintenance goals.',
      },
    ]}
  />
</BaseLayout>
