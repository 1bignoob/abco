---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';
import { createServicePageSchema } from '../../lib/schema';

const propertyMaintenanceSchema = createServicePageSchema({
  slug: 'property-maintenance',
  name: 'Property Maintenance Services in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Property maintenance services including lawn mowing, seasonal cleanup, fertilization, debris hauling, and deck or patio upkeep in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Property maintenance',
});
---

<BaseLayout
  title="Property Maintenance Services in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Year-round property maintenance for homes, businesses, and managed communities in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/property-maintenance/"
  image="/images/heros/landscaping-hero.webp"
  imageAlt="ABCO Landscaping maintained property in Gouldsboro and Eagle Lake, PA"
  schemaJson={propertyMaintenanceSchema}
>
  <ServiceDetailTemplate
    heroTitle="Property Maintenance Services in Eagle Lake, Gouldsboro & Covington Township, PA"
    heroIntro="Eagle Lake, Gouldsboro & Covington Township, PA"
    heroImageSrc="/images/heros/landscaping-hero.webp"
    heroImageAlt="ABCO Landscaping maintained property in Gouldsboro and Eagle Lake, PA"
    servicesHeading="What Our Property Maintenance Team Does"
    servicesIntro="Keeping a property looking its best year-round takes consistency. ABCO provides reliable maintenance programs for residential, commercial, and managed community properties."
    servicesOffered={[
      'Regular lawn mowing, edging, and blowing',
      'Fertilization, weed control, and overseeding',
      'Spring and fall seasonal cleanup',
      'Leaf removal and debris hauling',
      'Deck and patio cleaning prep',
      'General property upkeep and walkthroughs',
    ]}
    secondaryHeading="Maintenance for Managed and Multi-Site Properties"
    secondaryParagraphs={[
      'We support RV park owners, associations, and property managers with repeatable maintenance routines.',
      'Service plans can be adapted by site count, occupancy, and seasonal intensity.',
    ]}
    factsHeading="Property Maintenance Facts"
    facts={[
      'Residential, commercial, and RV',
      'Seasonal programs available',
      'Free estimates',
      'Mon-Fri 8 AM - 6 PM',
      'Sat 9:30 AM - 4:30 PM',
    ]}
    sidebarCtaPrompt="Ready to get started?"
    sidebarCtaLabel="Call (718) 877-1197"
    relatedServices={[
      { slug: 'landscaping', label: 'Landscaping', title: 'View landscaping services' },
      { slug: 'excavation', label: 'Excavation', title: 'View excavation services' },
    ]}
    didYouKnowIntro="Consistent maintenance schedules usually cost less over time than reactive one-off cleanup work."
    didYouKnowItems={[
      {
        title: 'Routine service protects curb appeal',
        body: 'Steady mowing, cleanup, and upkeep help properties stay presentable through the full season.',
      },
      {
        title: 'Preventive work lowers surprise costs',
        body: 'Addressing minor issues early can prevent larger cleanup and repair bills later.',
      },
      {
        title: 'Multi-site consistency matters',
        body: 'Standardized service plans make it easier for managers to maintain quality across locations.',
      },
    ]}
    faqHeading="Property Maintenance FAQ"
    faqItems={[
      {
        kicker: 'Programs',
        question: 'Do you offer recurring maintenance plans?',
        answer: 'Yes. We offer recurring schedules tailored to residential, commercial, and managed properties.',
      },
      {
        kicker: 'Service Area',
        question: 'Do you work with managed communities?',
        answer: 'Yes. We work with property managers and managed community sites in the service area.',
      },
      {
        kicker: 'Flexibility',
        question: 'Can services be adjusted seasonally?',
        answer: 'Yes. Plans can be adjusted by season, growth, and weather-driven needs.',
      },
    ]}
    listMarker="check"
  />
</BaseLayout>
