---
// NEWBIE MAP: Frontmatter sets imports, dynamic data, and route-level SEO metadata.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createServicePageSchema } from '../../lib/schema';
const base = import.meta.env.BASE_URL;
// NEWBIE MAP: This schema object is passed to BaseLayout and rendered as JSON-LD for SEO.
const winterizingSchema = createServicePageSchema({
  slug: 'winterizing',
  name: 'Winterizing Services in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Seasonal winter prep for properties including drainage checks, exterior cleanup, and cold-weather protection in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Winterizing',
});
---

{/* NEWBIE MAP: BaseLayout wraps this page with shared head tags, header, footer, and global styles. */}
<BaseLayout
  title="Winterizing Services in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Get your property ready for winter with practical exterior prep and seasonal protection services in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/winterizing/"
  schemaJson={winterizingSchema}
>

  {/* NEWBIE MAP: Page header controls the visible H1 and intro text for this route. */}
  <div class="page-header">
    <div class="container">
      <h1>Winterizing Services in Eagle Lake, Gouldsboro &amp; Covington Township, PA</h1>
      <p>Eagle Lake, Gouldsboro &amp; Covington Township, PA</p>
    </div>
  </div>

  {/* NEWBIE MAP: Main page content starts here; this is where route-specific sections live. */}
  <section class="service-detail section">
    <div class="container detail-grid">

      <div class="detail-content">
        <h2>What Our Winterizing Service Includes</h2>
        <hr class="orange-line" aria-hidden="true" />
        <p>
          ABCO helps homeowners and property managers reduce winter weather risk
          with practical exterior prep before freezing conditions arrive.
        </p>
        <ul class="detail-list">
          <li>Drainage path and runoff checks</li>
          <li>Yard and hardscape cleanup</li>
          <li>Vulnerable area prep recommendations</li>
          <li>Storm season property readiness</li>
          <li>Debris removal and haul-off</li>
          <li>Site-by-site winter prep planning</li>
        </ul>

        <h2>Prepare Before Freeze Cycles</h2>
        <p>
          Small seasonal issues become expensive repairs in winter. We help you
          address them early with a straightforward prep plan.
        </p>

        <div class="detail-cta">
          <a href={`${base}contact`} class="btn btn-primary" title="Request a free winterizing estimate">Request a Free Estimate</a>
          <a href={`${base}services`} class="btn btn-outline" title="View all ABCO services">All Services</a>
        </div>
      </div>

      <aside class="detail-sidebar">
        <div class="sidebar-box">
          <h3>Winterizing Service Facts</h3>
          <ul>
            <li><strong>Pre-winter site prep</strong></li>
            <li><strong>Residential &amp; commercial</strong></li>
            <li><strong>Custom recommendations</strong></li>
            <li><strong>Mon-Fri 8 AM - 6 PM</strong></li>
            <li><strong>Sat 9:30 AM - 4:30 PM</strong></li>
          </ul>
        </div>
        <div class="sidebar-box sidebar-cta">
          <p>Need winter prep support?</p>
          <a href="tel:+17188771197" class="btn btn-primary" title="Call ABCO Landscaping and Construction">Call (718) 877-1197</a>
        </div>
        <div class="sidebar-box">
          <h3>Related Outdoor Services</h3>
          <ul class="related-list">
            <li><a href={`${base}services/seasonal-cleanup`} title="View seasonal cleanup services">Seasonal Cleanup</a></li>
            <li><a href={`${base}services/property-maintenance`} title="View property maintenance services">Property Maintenance</a></li>
          </ul>
        </div>
      </aside>

    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(180deg, #1a1a1a 0%, #0d0d0d 100%);
    border-bottom: 1px solid #2e2e2e;
    padding-block: 3rem 2.5rem;
  }
  .page-header h1 { margin-bottom: 0.3rem; }
  .page-header p { color: #d95210; font-size: 1.1rem; font-weight: 600; max-width: none; }

  .service-detail { background: #0d0d0d; }

  .detail-grid { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: start; }

  .detail-content h2 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .detail-content p { color: #a09890; font-size: 1.1rem; line-height: 1.75; margin-bottom: 1.5rem; }

  .detail-list { list-style: none; padding: 0; margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .detail-list li { color: #c0b8b0; font-size: 1.1rem; padding-left: 1.5rem; position: relative; line-height: 1.5; }
  .detail-list li::before { content: '+'; color: #d95210; position: absolute; left: 0; font-weight: 700; }

  .detail-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }

  .detail-sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
  .sidebar-box { background: #1a1a1a; border: 1px solid #2e2e2e; border-radius: 8px; padding: 1.5rem; }
  .sidebar-box h3 { font-size: 1rem; color: #d95210; text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 1rem; }
  .sidebar-box ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .sidebar-box ul li { color: #c0b8b0; font-size: 1rem; }
  .sidebar-cta { text-align: center; }
  .sidebar-cta p { color: #a09890; font-size: 1rem; margin-bottom: 0.75rem; max-width: none; }
  .sidebar-cta .btn { width: 100%; }
  .related-list li a { color: #d95210; text-decoration: none; font-weight: 600; }
  .related-list li a:hover { color: #f06520; }

  @media (max-width: 800px) { .detail-grid { grid-template-columns: 1fr; } }
</style>
