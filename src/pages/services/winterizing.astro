---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';
import { createServicePageSchema } from '../../lib/schema';

const winterizingSchema = createServicePageSchema({
  slug: 'winterizing',
  name: 'Winterizing Services in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Seasonal winter prep for properties including drainage checks, exterior cleanup, and cold-weather protection in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Winterizing',
});
---

<BaseLayout
  title="Winterizing Services in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Get your property ready for winter with practical exterior prep and seasonal protection services in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/winterizing/"
  image="/images/heros/google-review-hero.webp"
  imageAlt="ABCO Landscaping and Construction project scene in the Eagle Lake, PA area"
  schemaJson={winterizingSchema}
>
  <ServiceDetailTemplate
    heroTitle="Winterizing Services in Eagle Lake, Gouldsboro & Covington Township, PA"
    heroIntro="Eagle Lake, Gouldsboro & Covington Township, PA"
    heroImageSrc="/images/heros/google-review-hero.webp"
    heroImageAlt="ABCO Landscaping and Construction project scene in the Eagle Lake, PA area"
    servicesHeading="What Our Winterizing Service Includes"
    servicesIntro="ABCO helps homeowners and property managers reduce winter weather risk with practical exterior prep before freezing conditions arrive."
    servicesOffered={[
      'Drainage path and runoff checks',
      'Yard and hardscape cleanup',
      'Vulnerable area prep recommendations',
      'Storm season property readiness',
      'Debris removal and haul-off',
      'Site-by-site winter prep planning',
    ]}
    secondaryHeading="Prepare Before Freeze Cycles"
    secondaryParagraphs={[
      'Small seasonal issues can become expensive repairs once freeze and thaw cycles begin.',
      'A pre-winter walkthrough gives you a clear action list before severe weather arrives.',
    ]}
    factsHeading="Winterizing Service Facts"
    facts={[
      'Pre-winter site prep',
      'Residential and commercial',
      'Custom recommendations',
      'Mon-Fri 8 AM - 6 PM',
      'Sat 9:30 AM - 4:30 PM',
    ]}
    sidebarCtaPrompt="Need winter prep support?"
    relatedServices={[
      { slug: 'seasonal-cleanup', label: 'Seasonal Cleanup', title: 'View seasonal cleanup services' },
      { slug: 'property-maintenance', label: 'Property Maintenance', title: 'View property maintenance services' },
    ]}
    didYouKnowIntro="Most winter property damage starts with small exterior issues that were easy to fix earlier in the season."
    didYouKnowItems={[
      {
        title: 'Drainage is a winter priority',
        body: 'Blocked runoff paths can lead to icing, pooling, and freeze-related surface damage.',
      },
      {
        title: 'Debris traps moisture',
        body: 'Leaves and buildup around structures can hold moisture where you do not want it in freeze cycles.',
      },
      {
        title: 'Planning beats emergency fixes',
        body: 'A simple pre-winter plan usually costs less and avoids cold-season service disruptions.',
      },
    ]}
    faqHeading="Winterizing FAQ"
    faqItems={[
      {
        kicker: 'Timing',
        question: 'When should winterizing be scheduled?',
        answer: 'Before consistent freezing temperatures set in, ideally during early to mid-fall.',
      },
      {
        kicker: 'Scope',
        question: 'Do you include cleanup in winterizing?',
        answer: 'Yes. Exterior cleanup and debris removal are part of most winterizing plans.',
      },
      {
        kicker: 'Benefits',
        question: 'Will this help reduce winter repair costs?',
        answer: 'Yes. Addressing small issues early can prevent larger weather-related damage later.',
      },
    ]}
  />
</BaseLayout>
