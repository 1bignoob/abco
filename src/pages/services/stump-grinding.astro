---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';
import { createServicePageSchema } from '../../lib/schema';

const stumpGrindingSchema = createServicePageSchema({
  slug: 'stump-grinding',
  name: 'Stump Grinding Services in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Professional stump grinding and stump removal for residential and commercial properties in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Stump Grinding',
});
---

<BaseLayout
  title="Stump Grinding Services in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Fast, clean stump grinding and removal for residential and commercial properties in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/stump-grinding/"
  image="/images/heros/stump-grinding-hero.webp"
  imageAlt="Stump grinding equipment and crew on a stump removal job near Eagle Lake, PA"
  schemaJson={stumpGrindingSchema}
>
  <ServiceDetailTemplate
    heroTitle="Stump Grinding Services in Eagle Lake, Gouldsboro & Covington Township, PA"
    heroIntro="Eagle Lake, Gouldsboro & Covington Township, PA"
    heroImageSrc="/images/heros/stump-grinding-hero.webp"
    heroImageMobileSrc="/images/heros/stump-grinding-hero-mobile.webp"
    heroImageObjectPosition="right 38%"
    heroImageAlt="Stump grinding equipment and crew on a stump removal job near Eagle Lake, PA"
    servicesHeading="What Our Stump Grinding Service Includes"
    servicesIntro="After a tree comes down, a stump can become a tripping hazard and a maintenance issue. ABCO grinds stumps below grade so the space can be reclaimed cleanly."
    servicesOffered={[
      'Single stumps or multiple stump jobs',
      'Ground below grade for replanting or turf',
      'Chip and debris cleanup included',
      'Standalone service or paired with tree removal',
      'Residential and commercial properties',
      'Tight-access locations handled',
    ]}
    secondaryHeading="Why Remove the Stump?"
    secondaryParagraphs={[
      'Leftover stumps can attract pests, limit mowing, and reduce usable yard space.',
      'Grinding removes the visible stump and helps prevent regrowth issues at the surface level.',
    ]}
    factsHeading="Stump Grinding Service Facts"
    facts={[
      'Residential and commercial',
      'Single or multi-stump jobs',
      'Debris cleanup included',
      'Mon-Fri 8 AM - 6 PM',
      'Sat 9:30 AM - 4:30 PM',
    ]}
    sidebarCtaPrompt="Ready to clear that stump?"
    relatedServices={[
      { slug: 'tree-removal', label: 'Tree Removal', title: 'View tree removal services' },
      { slug: 'landscaping', label: 'Landscaping', title: 'View landscaping services' },
    ]}
    didYouKnowIntro="Stump grinding can improve both site safety and the usability of the surrounding landscape area."
    didYouKnowItems={[
      {
        title: 'Stumps can damage mowing equipment',
        body: 'Hidden roots and uneven grade around old stumps make regular mowing harder and less safe.',
      },
      {
        title: 'Grinding helps reclaim planting space',
        body: 'Once ground below grade and cleaned up, the area can often be replanted or re-turfed.',
      },
      {
        title: 'Cleanup affects final curb appeal',
        body: 'Chip handling and finish cleanup are what turn a technical service into a clean finished result.',
      },
    ]}
    faqHeading="Stump Grinding FAQ"
    faqItems={[
      {
        kicker: 'Scope',
        question: 'Can you grind one stump or multiple stumps?',
        answer: 'Yes. We handle both single-stump jobs and larger multi-stump projects.',
      },
      {
        kicker: 'Depth',
        question: 'Do you grind below grade?',
        answer: 'Yes. We grind below grade so the area can be reused for turf, planting, or hardscape prep.',
      },
      {
        kicker: 'Pairing',
        question: 'Can stump grinding be bundled with tree removal?',
        answer: 'Yes. It can be scheduled as a standalone visit or combined with tree removal work.',
      },
    ]}
  />
</BaseLayout>
