---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { createServicePageSchema } from '../../lib/schema';
const base = import.meta.env.BASE_URL;
const stumpGrindingSchema = createServicePageSchema({
  slug: 'stump-grinding',
  name: 'Stump Grinding Services in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Professional stump grinding and stump removal for residential and commercial properties in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Stump Grinding',
});
---

<BaseLayout
  title="Stump Grinding Services in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Fast, clean stump grinding and removal for residential and commercial properties in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/stump-grinding/"
  schemaJson={stumpGrindingSchema}
>
  <ServiceHero
    title="Stump Grinding Services in Eagle Lake, Gouldsboro & Covington Township, PA"
    intro="Eagle Lake, Gouldsboro & Covington Township, PA"
  />

  <section class="service-detail section service-shared-gradient">
    <div class="container detail-grid">

      <div class="detail-content">
        <h2>What Our Stump Grinding Service Includes</h2>
        <hr class="orange-line" aria-hidden="true" />
        <p>
          After a tree comes down, the stump is often left behind — an eyesore and a
          tripping hazard. ABCO grinds stumps below grade so you can reclaim the space
          for planting, hardscaping, or turf.
        </p>
        <ul class="detail-list">
          <li>Single stumps or multiple stump jobs</li>
          <li>Ground below grade for replanting or turf</li>
          <li>Chip and debris cleanup included</li>
          <li>Works alongside tree removal or as a standalone service</li>
          <li>Residential and commercial properties</li>
          <li>Tight-access locations handled</li>
        </ul>

        <h2>Why Remove the Stump?</h2>
        <p>
          Leftover stumps attract pests, cause tripping hazards, and limit what you can
          do with your yard. Grinding removes the above-ground stump and grinds the
          surface root structure so it won't resprout or interfere with mowing.
        </p>

        <div class="detail-cta">
          <a href={`${base}contact`} class="btn btn-primary" title="Request a free stump grinding estimate">Request a Free Estimate</a>
          <a href={`${base}services`} class="btn btn-outline" title="View all ABCO services">All Services</a>
        </div>
      </div>

      <aside class="detail-sidebar">
        <div class="sidebar-box">
          <h3>Stump Grinding Service Facts</h3>
          <ul>
            <li><strong>Residential &amp; commercial</strong></li>
            <li><strong>Single or multi-stump jobs</strong></li>
            <li><strong>Debris cleanup included</strong></li>
            <li><strong>Mon-Fri 8 AM - 6 PM</strong></li>
            <li><strong>Sat 9:30 AM - 4:30 PM</strong></li>
          </ul>
        </div>
        <div class="sidebar-box sidebar-cta">
          <p>Ready to clear that stump?</p>
          <a href="tel:+17188771197" class="btn btn-primary" title="Call ABCO Landscaping and Construction">Call (718) 877-1197</a>
        </div>
        <div class="sidebar-box">
          <h3>Related Outdoor Services</h3>
          <ul class="related-list">
            <li><a href={`${base}services/tree-removal`} title="View tree removal services">Tree Removal</a></li>
            <li><a href={`${base}services/landscaping`} title="View landscaping services">Landscaping</a></li>
          </ul>
        </div>
      </aside>

    </div>
  </section>

</BaseLayout>

<style>
  .detail-grid { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: start; }

  .detail-content h2 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .detail-content p { color: var(--color-text-muted); font-size: 1.1rem; line-height: 1.75; margin-bottom: 1.5rem; }

  .detail-list { list-style: none; padding: 0; margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .detail-list li { color: var(--color-text-light); font-size: 1.1rem; padding-left: 1.5rem; position: relative; line-height: 1.5; }
  .detail-list li::before { content: '+'; color: var(--color-orange); position: absolute; left: 0; font-weight: 700; }

  .detail-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }

  .detail-sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
  .sidebar-box { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: 1.5rem; }
  .sidebar-box h3 { font-size: 1rem; color: var(--color-orange); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 1rem; }
  .sidebar-box ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .sidebar-box ul li { color: var(--color-text-light); font-size: 1rem; }
  .sidebar-cta { text-align: center; }
  .sidebar-cta p { color: var(--color-text-muted); font-size: 1rem; margin-bottom: 0.75rem; max-width: none; }
  .sidebar-cta .btn { width: 100%; }
  .related-list li a { color: var(--color-orange); text-decoration: none; font-weight: 600; }
  .related-list li a:hover { color: var(--color-orange-hov); }

  @media (max-width: 800px) { .detail-grid { grid-template-columns: 1fr; } }
</style>
