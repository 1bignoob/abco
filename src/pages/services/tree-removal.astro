---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';
import { createServicePageSchema } from '../../lib/schema';

const treeRemovalSchema = createServicePageSchema({
  slug: 'tree-removal',
  name: 'Tree Removal Services in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Safe tree removal, hazardous limb cleanup, storm damage response, and stump reduction for homes and commercial properties in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Tree Removal',
});
---

<BaseLayout
  title="Tree Removal Services in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Safe, reliable tree removal and storm cleanup for residential and commercial properties in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/tree-removal/"
  image="/images/heros/tree-removal-hero.webp"
  imageAlt="Tree removal crew and equipment working on a service call near Eagle Lake, PA"
  schemaJson={treeRemovalSchema}
>
  <ServiceDetailTemplate
    heroTitle="Tree Removal Services in Eagle Lake, Gouldsboro & Covington Township, PA"
    heroIntro="Eagle Lake, Gouldsboro & Covington Township, PA"
    heroImageSrc="/images/heros/tree-removal-hero.webp"
    heroImageMobileSrc="/images/heros/tree-removal-hero-mobile.webp"
    heroImageObjectPosition="35% 38%"
    heroImageAlt="Tree removal crew and equipment working on a service call near Eagle Lake, PA"
    servicesHeading="What Our Tree Removal Team Handles"
    servicesIntro="From one dangerous limb to full tree takedowns, ABCO handles removals with site safety and property protection first for homes, businesses, and managed properties."
    servicesOffered={[
      'Hazardous tree and limb removal',
      'Storm-damaged tree cleanup',
      'Low-clearance branch trimming',
      'Stump reduction and cleanup',
      'Debris hauling and disposal',
      'Site-safe cleanup and finish grading',
    ]}
    secondaryHeading="Tree Removal Process"
    secondaryParagraphs={[
      'We begin with a site review and a clear access and cleanup plan before work begins.',
      'You get a straightforward estimate, timeline, and cleanup scope before we start.',
    ]}
    factsHeading="Tree Removal Service Facts"
    facts={[
      'Residential and commercial',
      'Storm response available',
      'Debris cleanup included',
      'Mon-Fri 8 AM - 6 PM',
      'Sat 9:30 AM - 4:30 PM',
    ]}
    sidebarCtaPrompt="Need a dangerous tree removed?"
    relatedServices={[
      { slug: 'landscaping', label: 'Landscaping', title: 'View landscaping services' },
      { slug: 'property-maintenance', label: 'Property Maintenance', title: 'View property maintenance services' },
    ]}
    didYouKnowIntro="Tree removal is safer, cleaner, and faster when access, drop zones, and debris handling are planned up front."
    didYouKnowItems={[
      {
        title: 'Access planning protects your property',
        body: 'Planning equipment paths and work zones helps reduce turf and hardscape damage during removal.',
      },
      {
        title: 'Storm damage can hide internal risk',
        body: 'Cracked limbs and split trunks are not always obvious from the ground and should be assessed carefully.',
      },
      {
        title: 'Cleanup scope should be defined early',
        body: 'Knowing what gets hauled away and what remains keeps the final result predictable and clean.',
      },
    ]}
    faqHeading="Tree Removal FAQ"
    faqItems={[
      {
        kicker: 'Safety',
        question: 'Do you remove hazardous limbs near structures?',
        answer: 'Yes. We handle hazardous limbs and removals with a controlled approach and site protection in mind.',
      },
      {
        kicker: 'Storm Work',
        question: 'Can you help after storm damage?',
        answer: 'Yes. We provide storm-damage cleanup and tree removal support for affected properties.',
      },
      {
        kicker: 'Cleanup',
        question: 'Is debris hauling included?',
        answer: 'Yes. Debris hauling and cleanup are included in the project scope.',
      },
    ]}
  />
</BaseLayout>
