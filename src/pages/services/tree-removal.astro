---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { createServicePageSchema } from '../../lib/schema';
const base = import.meta.env.BASE_URL;
const treeRemovalSchema = createServicePageSchema({
  slug: 'tree-removal',
  name: 'Tree Removal Services in Eagle Lake, Gouldsboro & Covington Township, PA',
  description:
    'Safe tree removal, hazardous limb cleanup, storm damage response, and stump reduction for homes and commercial properties in Eagle Lake, Gouldsboro, and Covington Township, PA.',
  serviceType: 'Tree Removal',
});
---

<BaseLayout
  title="Tree Removal Services in Eagle Lake, Gouldsboro & Covington Township, PA"
  description="Safe, reliable tree removal and storm cleanup for residential and commercial properties in Eagle Lake, Gouldsboro, and Covington Township, PA."
  canonical="/services/tree-removal/"
  schemaJson={treeRemovalSchema}
>
  <ServiceHero
    title="Tree Removal Services in Eagle Lake, Gouldsboro & Covington Township, PA"
    intro="Eagle Lake, Gouldsboro & Covington Township, PA"
  />

  <section class="service-detail section service-shared-gradient">
    <div class="container detail-grid">

      <div class="detail-content">
        <h2>What Our Tree Removal Team Handles</h2>
        <hr class="orange-line" aria-hidden="true" />
        <p>
          From one dangerous limb to full tree takedowns, ABCO handles removals with
          site safety and property protection first. We work on homes, businesses,
          and managed properties throughout the Eagle Lake area.
        </p>
        <ul class="detail-list">
          <li>Hazardous tree and limb removal</li>
          <li>Storm-damaged tree cleanup</li>
          <li>Low-clearance branch trimming</li>
          <li>Stump reduction and cleanup</li>
          <li>Debris hauling and disposal</li>
          <li>Site-safe cleanup and finish grading</li>
        </ul>

        <h2>Tree Removal Process</h2>
        <p>
          We begin with a site review and clear plan for equipment access and debris
          handling. You get a straightforward estimate, timeline, and cleanup scope
          before work begins.
        </p>

        <div class="detail-cta">
          <a href={`${base}contact`} class="btn btn-primary" title="Request a free tree removal estimate">Request a Free Estimate</a>
          <a href={`${base}services`} class="btn btn-outline" title="View all ABCO services">All Services</a>
        </div>
      </div>

      <aside class="detail-sidebar">
        <div class="sidebar-box">
          <h3>Tree Removal Service Facts</h3>
          <ul>
            <li><strong>Residential &amp; commercial</strong></li>
            <li><strong>Storm response available</strong></li>
            <li><strong>Debris cleanup included</strong></li>
            <li><strong>Mon-Fri 8 AM - 6 PM</strong></li>
            <li><strong>Sat 9:30 AM - 4:30 PM</strong></li>
          </ul>
        </div>
        <div class="sidebar-box sidebar-cta">
          <p>Need a dangerous tree removed?</p>
          <a href="tel:+17188771197" class="btn btn-primary" title="Call ABCO Landscaping and Construction">Call (718) 877-1197</a>
        </div>
        <div class="sidebar-box">
          <h3>Related Outdoor Services</h3>
          <ul class="related-list">
            <li><a href={`${base}services/landscaping`} title="View landscaping services">Landscaping</a></li>
            <li><a href={`${base}services/property-maintenance`} title="View property maintenance services">Property Maintenance</a></li>
          </ul>
        </div>
      </aside>

    </div>
  </section>

</BaseLayout>

<style>
  .detail-grid { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: start; }

  .detail-content h2 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .detail-content p { color: #a09890; font-size: 1.1rem; line-height: 1.75; margin-bottom: 1.5rem; }
  .detail-content a:not(.btn) { color: #d95210; }

  .detail-list { list-style: none; padding: 0; margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .detail-list li { color: #c0b8b0; font-size: 1.1rem; padding-left: 1.5rem; position: relative; line-height: 1.5; }
  .detail-list li::before { content: '+'; color: #d95210; position: absolute; left: 0; font-weight: 700; }

  .detail-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }

  .detail-sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
  .sidebar-box { background: #1a1a1a; border: 1px solid #2e2e2e; border-radius: 8px; padding: 1.5rem; }
  .sidebar-box h3 { font-size: 1rem; color: #d95210; text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 1rem; }
  .sidebar-box ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .sidebar-box ul li { color: #c0b8b0; font-size: 1rem; }
  .sidebar-cta { text-align: center; }
  .sidebar-cta p { color: #a09890; font-size: 1rem; margin-bottom: 0.75rem; max-width: none; }
  .sidebar-cta .btn { width: 100%; }
  .related-list li a { color: #d95210; text-decoration: none; font-weight: 600; }
  .related-list li a:hover { color: #f06520; }

  @media (max-width: 800px) { .detail-grid { grid-template-columns: 1fr; } }
</style>
