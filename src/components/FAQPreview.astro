---
// ─── FAQPreview.astro ────────────────────────────────────────────────────────
// A short FAQ teaser shown on the homepage — 4 questions max.
// NOT the full FAQ page (that lives at src/pages/faq.astro).
//
// TO EDIT QUESTIONS: update the `faqs` array below.
// TO ADD MORE: add objects with `q` (question) and `a` (answer) keys.
// The "View all FAQs" link at the bottom points to /faq.
// ─────────────────────────────────────────────────────────────────────────────
const base = import.meta.env.BASE_URL;
// Edit these 4 Q&As freely — they appear in the same order as the array.
const faqs = [
  {
    q: 'What areas do you serve?',
    a: 'We serve Eagle Lake, Gouldsboro, Covington Township, and surrounding communities in northeastern Pennsylvania (ZIP 18424).',
  },
  {
    q: 'Do you offer free estimates?',
    a: 'Yes — we provide free, no-obligation estimates for all landscaping, excavation, and property maintenance projects.',
  },
  {
    q: 'What are your business hours?',
    a: 'Monday through Friday 8:00 AM – 6:00 PM, Saturday 9:30 AM – 4:30 PM. We are closed on Sundays.',
  },
  {
    q: 'Do you work with residential and commercial customers?',
    a: 'Absolutely. We take on residential homeowners, commercial property managers, and RV community sites across the Eagle Lake area.',
  },
];
---

<section class="faq-preview section" aria-labelledby="faq-heading">
  <div class="container">

    <div class="section-header">
      <h2 id="faq-heading">Landscaping, Excavation &amp; Property Maintenance FAQs</h2>
      <hr class="orange-line" aria-hidden="true" />
    </div>

    <dl class="faq-list">
      {faqs.map(item => (
        <div class="faq-item">
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </div>
      ))}
    </dl>

    <p class="faq-more">
      <a href={`${base}faq`} title="View all ABCO landscaping and excavation FAQs">View all FAQs →</a>
    </p>

  </div>
</section>

<style>
  .faq-preview { background-color: var(--color-bg); }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
  }

  .faq-item {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item:last-child { border-bottom: none; }

  .faq-item dt {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 0.5rem;
  }

  .faq-item dd {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-left: 0;
    max-width: 72ch;
  }

  .faq-more {
    margin-top: 1.5rem;
    font-size: 1.1rem;
    font-weight: 600;
    max-width: none;
  }

  .faq-more a {
    color: var(--color-orange);
    text-decoration: none;
  }
  .faq-more a:hover { color: var(--color-orange-hov); }
</style>
