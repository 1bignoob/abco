---
{/*
  ServiceCards.astro — Homepage service grid
  ─────────────────────────────────────────
  This component renders the row of service cards on the homepage (index.astro).
  It is NOT the full services page (/services/) — that lives in:
    src/pages/services/index.astro

  HOW TO ADD OR EDIT A SERVICE CARD:
  1. Add a new object to the `services` array below.
  2. Give it: icon (emoji), title, description, and href (the URL to its page).
  3. Make sure the page exists in src/pages/services/your-slug.astro
  4. Make sure the service is also listed in src/lib/schema.ts (createHomePageSchema)
     and in src/components/Header.astro (the navLinks children array).

  Each card automatically gets a hover effect and a full-card clickable link.
  The arrow (→) at the bottom slides right on hover — that's handled by CSS below.
*/}

const base = import.meta.env.BASE_URL;

{/* ── SERVICE CARD DATA ─────────────────────────────────────────────────────────
   Each object = one card. Fields:
     icon        → emoji shown at the top of the card
     title       → bold heading on the card
     description → paragraph text under the heading
     href        → where clicking the card takes the user
   ─────────────────────────────────────────────────────────────────────────── */}
const services = [
  {
    icon: '🌿',
    title: 'Landscaping',
    description:
      'Full-service landscaping for residential and commercial properties — design, planting, tree pruning, removal, and seasonal lawn care to keep your property looking its best.',
    href: `${base}services/landscaping`,
  },
  {
    icon: '🏗️',
    title: 'Excavation',
    description:
      'Professional excavation, grading, leveling, and resurfacing services for construction projects of any scale throughout Covington Township and the surrounding area.',
    href: `${base}services/excavation`,
  },
  {
    icon: '🏡',
    title: 'Property Maintenance',
    description:
      'Reliable year-round maintenance including lawn mowing, fertilization, weed control, deck and patio upkeep, and seasonal cleanup for homes, businesses, and RV sites.',
    href: `${base}services/property-maintenance`,
  },
  {
    icon: '🌳',
    title: 'Tree Removal',
    description:
      'Safe removal of hazardous trees and limbs with full debris cleanup for residential and commercial properties across Eagle Lake and nearby communities.',
    href: `${base}services/tree-removal`,
  },
  {
    icon: '🪵',
    title: 'Stump Grinding',
    description:
      'Professional stump grinding and removal to clear leftover stumps after tree work — ground below grade for replanting, turf, or hardscaping.',
    href: `${base}services/stump-grinding`,
  },
  {
    icon: '🍂',
    title: 'Seasonal Cleanup',
    description:
      'Spring and fall cleanups that remove debris, refresh planting areas, and prepare your property for weather transitions — including leaf removal and bed clearing.',
    href: `${base}services/seasonal-cleanup`,
  },
  {
    icon: '🪨',
    title: 'Gravel Delivery & Spreading',
    description:
      'Bulk gravel delivery, base prep, and spreading for driveways and access lanes, with finish grading for proper drainage and long-term durability.',
    href: `${base}services/gravel`,
  },
  {
    icon: '❄️',
    title: 'Winterizing',
    description:
      'Seasonal exterior preparation to reduce winter weather damage — including drainage checks, debris cleanup, and pre-winter site readiness planning.',
    href: `${base}services/winterizing`,
  },
  {
    icon: '🏠',
    title: 'Park Model Home Repair',
    description:
      'Specialized repair and exterior maintenance support for park model homes and surrounding site areas, including deck maintenance and site grading corrections.',
    href: `${base}services/park-model-home-repair`,
  },
];
---

{/* ── SECTION WRAPPER ───────────────────────────────────────────────────────────
   The outer <section> gives screen readers a landmark label via aria-labelledby.
   The gradient background is defined in the <style> block below — it blends
   from the warm hero image color into the dark site background.
*/}
<section class="services-section" aria-labelledby="services-heading">
  <div class="container">

    {/* Section heading + subtitle */}
    <div class="section-header text-center">
      <h2 id="services-heading">Full-Service Landscaping, Excavation &amp; Property Maintenance in Eagle Lake, PA</h2>
      <hr class="orange-line center" aria-hidden="true" />
      <p>
        Residential, commercial, and RV owners throughout Eagle Lake,
        Gouldsboro, and Covington Township, PA trust ABCO Guys for
        quality outdoor work done right.
      </p>
    </div>

    {/* ── CARD GRID ──────────────────────────────────────────────────────────────
       services.map() loops over the array above and renders one <article> per
       entry. The grid layout (columns/spacing) is controlled by .svc-grid in CSS.
       The full card is clickable because .svc-link::after stretches an invisible
       overlay across the entire card (see CSS at the bottom of this file).
    */}
    <div class="svc-grid">
      {services.map(s => (
        <article class="svc-card">
          <div class="svc-icon" aria-hidden="true">{s.icon}</div>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
          {/* The title attribute adds a browser tooltip on hover */}
          <a href={s.href} class="svc-link" title={`Learn more about ${s.title.toLowerCase()} services from ABCO`}>
            Learn More <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  /*
   * STYLES FOR ServiceCards.astro
   * ─────────────────────────────────────────────────────────────────────────────
   * These styles are scoped to this component only — they won't leak to other
   * pages. The class names here (.svc-card, .svc-grid, etc.) are only meaningful
   * inside this file.
   *
   * QUICK REFERENCE:
   *   .services-section  → the outer <section> wrapper with the gradient bg
   *   .svc-grid          → the CSS grid that lays out the cards in columns
   *   .svc-card          → individual card box (hover lifts it up)
   *   .svc-icon          → the large emoji at the top of each card
   *   .svc-link          → the orange "Learn More →" link
   *   .svc-link::after   → invisible overlay that makes the WHOLE card clickable
   */

  .services-section {
    /* Gradient that blends from the warm hero image color into the dark background.
       Adjust the color stops here if the hero image changes. */
    background: linear-gradient(
      180deg,
      #2e1405 0%,
      #1c0e04 18%,
      #141414 50%,
      #0d0d0d 100%
    );
    padding-block: 5rem;
  }

  .svc-grid {
    display: grid;
    /* auto-fit: fills as many columns as fit; min 300px wide, max 1fr (equal width).
       On mobile this naturally collapses to a single column. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }

  .svc-card {
    position: relative; /* required so .svc-link::after (the click overlay) is positioned relative to the card */
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(217, 82, 16, 0.28);
    border-radius: 10px;
    padding: 2rem;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  /* On hover: full orange border, card lifts slightly, orange glow shadow */
  .svc-card:hover {
    border-color: #d95210;
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(217, 82, 16, 0.15);
  }

  /* Heading turns orange when card is hovered */
  .svc-card:hover h3 {
    color: #d95210;
  }

  .svc-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .svc-card h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    color: #fff;
  }

  .svc-card p {
    color: #b0a8a0;
    line-height: 1.75;
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  /* Orange "Learn More →" link at the bottom of each card */
  .svc-link {
    color: #d95210;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.2s;
  }

  .svc-link:hover { color: #f06520; }

  /* The arrow (→) slides right on card hover */
  .svc-link span {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .svc-card:hover .svc-link span {
    transform: translateX(5px);
  }

  /*
   * FULL-CARD CLICK TRICK
   * ::after creates an invisible box that covers the entire card.
   * This makes clicking anywhere on the card follow the <a> link,
   * not just the "Learn More" text. z-index: 1 puts it above the card
   * content so it catches clicks everywhere.
   * DO NOT remove position: relative from .svc-card or this will break.
   */
  .svc-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
