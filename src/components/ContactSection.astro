---
// ─── ContactSection.astro ────────────────────────────────────────────────────
// The contact form section — used on the homepage and the /contact page.
//
// FORM SUBMISSION: handled by Web3Forms (https://web3forms.com)
//   • access_key    → the Web3Forms account key (hidden input)
//   • botcheck      → honeypot field (hidden checkbox to block spam bots)
//   • redirect      → set to "false" so we handle success in JS (no page reload)
//
// ON SUBMIT:
//   • The form POSTs to Web3Forms via fetch() in the <script> block
//   • On success: form hides, #cf-thankyou div shows
//   • On failure: user sees an alert
//
// TO CHANGE where emails go: log into web3forms.com and update the access_key.
// TO ADD FIELDS: add a new <input> with a matching `name` attribute.
// ─────────────────────────────────────────────────────────────────────────────
---

<section class="contact-section section" aria-labelledby="contact-heading" id="contact">
  <div class="container contact-grid">

    <div class="contact-text">
      <h2 id="contact-heading">Request a Landscaping, Excavation, or Property Maintenance Estimate</h2>
      <hr class="orange-line" aria-hidden="true" />
      <p>
        Have a question or need an estimate? Fill out the form and
        we'll get back to you as soon as possible. You can also call
        or email us directly.
      </p>
      <ul class="contact-details" aria-label="Contact details">
        <li>
          <span aria-hidden="true">📞</span>
          <a href="tel:+17188771197" title="Call ABCO Landscaping and Construction">(718) 877-1197</a>
        </li>
        <li>
          <span aria-hidden="true">✉️</span>
          <a href="mailto:sales@abcoguys.com" title="Email ABCO Landscaping and Construction">sales@abcoguys.com</a>
        </li>
        <li>
          <span aria-hidden="true">🌐</span>
          <a href="https://abcoguys.com" title="Visit abcoguys.com">abcoguys.com</a>
        </li>
      </ul>
    </div>

    <div class="contact-form-wrap">
      <form
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="contact-form"
        aria-label="Contact form"
        novalidate
      >
        <input type="hidden" name="access_key" value="45cf7455-aaec-477c-b046-b458c3c8a9bf" />
        <input type="hidden" name="subject" id="cf-subject" value="New message from abcoguys.com" />
        <input type="hidden" name="redirect" value="false" />
        <!-- Honeypot spam protection -->
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" aria-hidden="true" />

        <div id="cf-error-summary" class="form-error-summary" role="alert" tabindex="-1" hidden>
          <p id="cf-error-summary-text"></p>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="cf-name">Your Name <span aria-hidden="true" class="required">*</span></label>
            <input
              type="text"
              id="cf-name"
              name="name"
              autocomplete="name"
              required
              minlength="2"
              aria-required="true"
              aria-describedby="cf-name-error"
              placeholder="Jane Smith"
            />
            <p id="cf-name-error" class="field-error" hidden>Enter at least 2 characters for your name.</p>
          </div>
          <div class="form-field">
            <label for="cf-phone">Phone Number</label>
            <input
              type="tel"
              id="cf-phone"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              aria-describedby="cf-phone-hint cf-contact-hint cf-contact-error cf-phone-error"
              placeholder="(555) 000-0000"
            />
            <p id="cf-phone-hint" class="field-hint">US numbers only: 10 digits, or 11 digits starting with 1. Spaces, parentheses, hyphens, and a leading + are allowed.</p>
            <p id="cf-phone-error" class="field-error" hidden>Enter a valid US phone number with 10 digits, or 11 digits starting with 1.</p>
          </div>
        </div>

        <div class="form-field">
          <label for="cf-email">Email Address</label>
          <input
            type="email"
            id="cf-email"
            name="email"
            autocomplete="email"
            aria-describedby="cf-contact-hint cf-contact-error cf-email-error"
            placeholder="you@example.com"
          />
          <p id="cf-contact-hint" class="field-hint">Provide at least one: phone number or email address.</p>
          <p id="cf-contact-error" class="field-error" hidden>Enter a phone number or email address.</p>
          <p id="cf-email-error" class="field-error" hidden>Enter a valid email address, such as name@example.com.</p>
        </div>

        <div class="form-field">
          <label for="cf-service">Service Needed</label>
          <select id="cf-service" name="service">
            <option value="">— Select a service —</option>
            <option value="Landscaping">Landscaping</option>
            <option value="Excavation">Excavation</option>
            <option value="Property Maintenance">Property Maintenance</option>
            <option value="Other">Other / Not Sure</option>
          </select>
        </div>

        <div class="form-field">
          <label for="cf-message">Message <span aria-hidden="true" class="required">*</span></label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            required
            aria-required="true"
            aria-describedby="cf-message-error"
            placeholder="Describe what you need..."
          ></textarea>
          <p id="cf-message-error" class="field-error" hidden>Enter a message.</p>
        </div>

        <button type="submit" class="btn btn-primary" id="cf-submit">Send Message</button>

      </form>

      <div id="cf-thankyou" class="cf-thankyou" aria-live="polite" hidden>
        <div class="ty-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52" fill="none" aria-hidden="true">
            <circle cx="26" cy="26" r="25" stroke="currentColor" stroke-width="2"/>
            <path d="M14 27l9 9 15-18" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3>Message Received!</h3>
        <p>Thanks for reaching out. We'll be in touch shortly — usually within one business day.</p>
      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const thankyou = document.getElementById('cf-thankyou') as HTMLElement | null;
  const nameInput = document.getElementById('cf-name') as HTMLInputElement | null;
  const phoneInput = document.getElementById('cf-phone') as HTMLInputElement | null;
  const emailInput = document.getElementById('cf-email') as HTMLInputElement | null;
  const messageInput = document.getElementById('cf-message') as HTMLTextAreaElement | null;
  const subjectInput = document.getElementById('cf-subject') as HTMLInputElement | null;
  const errorSummary = document.getElementById('cf-error-summary') as HTMLElement | null;
  const errorSummaryText = document.getElementById('cf-error-summary-text') as HTMLParagraphElement | null;
  const nameError = document.getElementById('cf-name-error') as HTMLElement | null;
  const contactError = document.getElementById('cf-contact-error') as HTMLElement | null;
  const phoneError = document.getElementById('cf-phone-error') as HTMLElement | null;
  const emailError = document.getElementById('cf-email-error') as HTMLElement | null;
  const messageError = document.getElementById('cf-message-error') as HTMLElement | null;

  type FormControl = HTMLInputElement | HTMLTextAreaElement;

  const isPhoneValid = (phone: string) => {
    if (!phone) return true;

    const phoneBody = phone.startsWith('+') ? phone.slice(1) : phone;
    if (!phoneBody || /[^0-9 ()-]/.test(phoneBody)) return false;

    const digits = phoneBody.replace(/[^0-9]/g, '');
    return digits.length === 10 || (digits.length === 11 && digits.startsWith('1'));
  };

  const setFieldError = (control: FormControl | null, error: HTMLElement | null, show: boolean) => {
    if (control) {
      if (show) control.setAttribute('aria-invalid', 'true');
      else control.removeAttribute('aria-invalid');
    }
    if (error) error.hidden = !show;
  };

  const syncContactInvalidState = () => {
    const contactIsShown = Boolean(contactError && !contactError.hidden);
    const phoneIsShown = Boolean(phoneError && !phoneError.hidden);
    const emailIsShown = Boolean(emailError && !emailError.hidden);
    if (phoneInput) {
      if (contactIsShown || phoneIsShown) phoneInput.setAttribute('aria-invalid', 'true');
      else phoneInput.removeAttribute('aria-invalid');
    }
    if (emailInput) {
      if (contactIsShown || emailIsShown) emailInput.setAttribute('aria-invalid', 'true');
      else emailInput.removeAttribute('aria-invalid');
    }
  };

  const syncErrorSummary = () => {
    if (!errorSummary || !errorSummaryText || errorSummary.hidden) return;
    const count = [nameError, contactError, phoneError, emailError, messageError]
      .filter((error) => error && !error.hidden).length;

    if (count === 0) {
      errorSummary.hidden = true;
      return;
    }

    errorSummaryText.textContent = `Please correct ${count} ${count === 1 ? 'error' : 'errors'} in the form.`;
  };

  const clearContactErrorIfValid = () => {
    if (phoneInput?.value.trim() || emailInput?.value.trim()) {
      if (contactError) contactError.hidden = true;
      syncContactInvalidState();
    }
  };

  // Keep subject in sync with name field
  nameInput?.addEventListener('input', () => {
    if (subjectInput && nameInput.value.trim()) {
      subjectInput.value = `${nameInput.value.trim()} sent a message through abcoguys.com`;
    }
    if (nameInput.value.trim().length >= 2) setFieldError(nameInput, nameError, false);
    syncErrorSummary();
  });

  phoneInput?.addEventListener('input', () => {
    clearContactErrorIfValid();
    const phone = phoneInput.value.trim();
    if (!phone || isPhoneValid(phone)) {
      if (phoneError) phoneError.hidden = true;
      syncContactInvalidState();
    }
    syncErrorSummary();
  });

  emailInput?.addEventListener('input', () => {
    clearContactErrorIfValid();
    if (!emailInput.value.trim() || !emailInput.validity.typeMismatch) {
      if (emailError) emailError.hidden = true;
      syncContactInvalidState();
    }
    syncErrorSummary();
  });

  messageInput?.addEventListener('input', () => {
    if (messageInput.value.trim()) setFieldError(messageInput, messageError, false);
    syncErrorSummary();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement | null;

    const nameIsInvalid = (nameInput?.value.trim().length ?? 0) < 2;
    const phone = phoneInput?.value.trim() ?? '';
    const email = emailInput?.value.trim() ?? '';
    const contactIsInvalid = !phone && !email;
    const phoneIsInvalid = Boolean(phone && !isPhoneValid(phone));
    const emailIsInvalid = Boolean(email && emailInput?.validity.typeMismatch);
    const messageIsInvalid = !messageInput?.value.trim();

    setFieldError(nameInput, nameError, nameIsInvalid);
    if (contactError) contactError.hidden = !contactIsInvalid;
    if (phoneError) phoneError.hidden = !phoneIsInvalid;
    if (emailError) emailError.hidden = !emailIsInvalid;
    syncContactInvalidState();
    setFieldError(messageInput, messageError, messageIsInvalid);

    const firstInvalid = [
      nameIsInvalid ? nameInput : null,
      contactIsInvalid ? phoneInput : null,
      phoneIsInvalid ? phoneInput : null,
      emailIsInvalid ? emailInput : null,
      messageIsInvalid ? messageInput : null,
    ].find((control): control is FormControl => control !== null);

    if (firstInvalid) {
      if (errorSummary && errorSummaryText) {
        errorSummary.hidden = false;
        const errorCount = [nameIsInvalid, contactIsInvalid, phoneIsInvalid, emailIsInvalid, messageIsInvalid]
          .filter(Boolean).length;
        errorSummaryText.textContent = `Please correct ${errorCount} ${errorCount === 1 ? 'error' : 'errors'} in the form.`;
      }
      firstInvalid.focus();
      return;
    }

    if (errorSummary) errorSummary.hidden = true;
    if (nameInput) nameInput.value = nameInput.value.trim();
    if (phoneInput) phoneInput.value = phone;
    if (emailInput) emailInput.value = email;
    if (messageInput) messageInput.value = messageInput.value.trim();
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
      });
      const data = await res.json();
      if (data.success) {
        form.reset();
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Thank you';
          submitBtn.classList.add('btn-sent');
        }
        if (thankyou) thankyou.hidden = false;
      } else {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send Message'; }
        alert('Something went wrong. Please try calling us at (718) 877-1197.');
      }
    } catch {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send Message'; }
      alert('Network error. Please try calling us at (718) 877-1197.');
    }
  });
</script>

<style>
  .contact-section { background-color: var(--color-surface-dark); }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-text p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .contact-details {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .contact-details li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.1rem;
  }

  .contact-details a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }
  .contact-details a:hover { color: var(--color-orange); }

  /* Form */
  .contact-form-wrap {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 2.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-mid);
  }

  .required { color: var(--color-orange); }

  .field-hint,
  .field-error {
    font-size: 0.9rem;
    line-height: 1.4;
    margin: 0;
  }

  .field-hint { color: var(--color-text-muted); }

  .field-error {
    color: var(--color-orange-hov);
    font-weight: 600;
  }

  .form-error-summary {
    background: rgba(217, 82, 16, 0.12);
    border: 1px solid var(--color-orange);
    border-radius: 4px;
    color: var(--color-text);
    padding: 0.85rem 1rem;
  }

  .form-error-summary p { margin: 0; }

  input[type="text"],
  input[type="tel"],
  input[type="email"],
  select,
  textarea {
    background: var(--color-surface-dark);
    border: 1px solid var(--color-border-input);
    border-radius: 4px;
    color: var(--color-text);
    font-family: inherit;
    font-size: 1.05rem;
    padding: 0.75rem 1rem;
    transition: border-color 0.2s;
    width: 100%;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-orange);
    outline: none;
    box-shadow: 0 0 0 3px rgba(217, 82, 16, 0.25);
  }

  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: var(--color-orange-hov);
  }

  textarea { resize: vertical; min-height: 130px; }

  select option { background: var(--color-surface); }

  .contact-form .btn {
    align-self: flex-start;
    font-size: 1.1rem;
    padding: 0.9rem 2.25rem;
  }

  .contact-form .btn-sent {
    background: var(--color-disabled) !important;
    color: var(--color-disabled-text) !important;
    border-color: var(--color-disabled) !important;
    cursor: default;
  }

  .cf-thankyou {
    text-align: center;
    padding: 3rem 2rem;
  }

  .ty-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
    color: var(--color-orange);
  }

  .ty-icon svg {
    width: 56px;
    height: 56px;
  }

  .cf-thankyou h3 {
    font-size: 1.6rem;
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .cf-thankyou p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
