---
// ─── Footer.astro ─────────────────────────────────────────────────────────────
// Site-wide footer rendered on every page via BaseLayout.astro.
//
// FOUR COLUMN GRID:
//   1. Brand/Contact → business name, tagline, phone, email, Facebook link
//   2. Services      → quick links to 3 main services + "All Services"
//   3. Company       → About, Blog, FAQ, Contact
//   4. Hours         → operating hours
//
// BOTTOM BAR: copyright, site credit, and legal links (Terms, Privacy, Disclaimer)
//
// TO UPDATE HOURS: edit the .hours-list <li> items in the HTML
// TO UPDATE PHONE/EMAIL: change the <a href="tel:"> and <a href="mailto:"> values
// TO ADD A SERVICE LINK: add a new <li> in the "Services" column
//
// Year is auto-calculated via `new Date().getFullYear()`.
// ─────────────────────────────────────────────────────────────────────────────
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">

  <div class="footer-main container">
    <div class="footer-grid">

      <!-- Brand / Contact -->
      <div class="footer-brand">
        <p class="footer-name">ABCO Landscaping &amp; Construction</p>
        <p class="footer-tagline">Serving Eagle Lake, Gouldsboro &amp; Covington Township, PA</p>

        <p class="footer-contact-row">
          <a href="tel:+17188771197" aria-label="Call ABCO at 718-877-1197" title="Call ABCO Landscaping and Construction">(718) 877-1197</a>
        </p>
        <p class="footer-contact-row">
          <a href="mailto:sales@abcoguys.com" title="Email ABCO Landscaping and Construction">sales@abcoguys.com</a>
        </p>
        <!-- Address placeholder — add when ready -->
        <!-- <address class="footer-address">[Business Address, Gouldsboro, PA 18424]</address> -->

        <div class="footer-social">
          <a
            href="https://www.facebook.com/share/1b15VtsNao/?mibextid=wwXIfr"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ABCO Landscaping on Facebook (opens in new tab)"
            title="Visit ABCO Landscaping and Construction on Facebook"
          >
            Facebook
          </a>
        </div>
      </div>

      <!-- Services -->
      <div class="footer-col">
        <h3>Services</h3>
        <ul>
          <li><a href={`${base}services/landscaping`} title="Landscaping Services">Landscaping</a></li>
          <li><a href={`${base}services/excavation`} title="Excavation Services">Excavation</a></li>
          <li><a href={`${base}services/property-maintenance`} title="Property Maintenance Services">Property Maintenance</a></li>
          <li><a href={`${base}services`} title="All Services">All Services</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div class="footer-col">
        <h3>Company</h3>
        <ul>
          <li><a href={`${base}about`} title="About ABCO Landscaping">About Us</a></li>
          <li><a href={`${base}blog`} title="ABCO Landscaping Blog">Blog</a></li>
          <li><a href={`${base}faq`} title="Frequently Asked Questions">FAQ</a></li>
          <li><a href={`${base}contact`} title="Contact ABCO Landscaping">Contact Us</a></li>
        </ul>
      </div>

      <!-- Hours -->
      <div class="footer-col">
        <h3>Hours</h3>
        <ul class="hours-list">
          <li><span>Mon – Fri</span><span>8:00 AM – 6:00 PM</span></li>
          <li><span>Saturday</span><span>9:30 AM – 4:30 PM</span></li>
          <li><span>Sunday</span><span>Closed</span></li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copy">&copy; {year} Abco Landscaping &amp; Construction &middot; All Rights Reserved</p>
      <p class="footer-credit">Site by <a href="https://GothamWebDev.com" target="_blank" rel="noopener noreferrer" title="Visit GothamWebDev">GothamWebDev.com</a></p>
      <nav class="footer-legal" aria-label="Legal links">
        <a href={`${base}terms-of-use`} title="Terms of Use">Terms of Use</a>
        <a href={`${base}privacy-policy`} title="Privacy Policy">Privacy Policy</a>
        <a href={`${base}disclaimer`} title="Disclaimer">Disclaimer</a>
      </nav>
    </div>
  </div>

</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-footer);
    border-top: 3px solid var(--color-orange);
    margin-top: auto;
  }

  .footer-main { padding-block: 1.2rem 0.75rem; }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 0.9rem;
  }

  /* Brand column */
  .footer-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 0.15rem;
  }
  .footer-tagline {
    color: var(--color-text-mid);
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
    max-width: 34ch;
  }
  .footer-contact-row {
    margin-bottom: 0.05rem;
  }
  .footer-contact-row a {
    color: var(--color-text-mid);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .footer-contact-row a:hover { color: var(--color-orange); }

  .footer-social { margin-top: 0.3rem; }
  .footer-social a {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-mid);
    text-decoration: none;
    font-size: 0.95rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .footer-social a:hover { border-color: var(--color-orange); color: var(--color-orange); }

  /* Other columns */
  .footer-col h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-orange);
    margin-bottom: 0.55rem;
    font-weight: 700;
  }

  .footer-col ul,
  .hours-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-col ul a {
    color: var(--color-text-mid);
    text-decoration: none;
    font-size: 1rem;
    transition: color 0.2s;
  }
  .footer-col ul a:hover { color: var(--color-text); }

  .hours-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.25;
    color: var(--color-text-mid);
    white-space: nowrap;
  }
  .hours-list li span:last-child {
    text-align: right;
    min-width: 7.75rem;
  }
  .hours-list li span:first-child { color: var(--color-text-light); }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid var(--color-surface);
    padding-block: 0.75rem;
  }
  .footer-bottom-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-mid);
  }
  .footer-copy {
    color: var(--color-text-mid);
    max-width: none;
    justify-self: start;
  }
  .footer-credit {
    color: var(--color-text-mid);
    max-width: none;
    justify-self: center;
    text-align: center;
  }
  .footer-credit a {
    color: var(--color-gold);
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-credit a:hover { color: var(--color-gold-hov); }
  .footer-legal {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-self: end;
    justify-content: flex-end;
  }
  .footer-legal a {
    color: var(--color-text-mid);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-legal a:hover { color: var(--color-text-muted); }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 800px) {
    .footer-bottom-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .footer-copy { justify-self: center; order: 1; }
    .footer-legal { justify-self: center; justify-content: center; order: 2; }
    .footer-credit { justify-self: center; order: 3; }
  }

  @media (max-width: 550px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
