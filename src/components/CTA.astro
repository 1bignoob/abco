---
// ─── CTA.astro ────────────────────────────────────────────────────────────────
// Reusable full-width orange call-to-action banner.
// Used on: homepage (index.astro) and can be dropped into any page.
//
// Props (both optional — defaults shown below):
//   heading  → the bold headline text
//   subtext  → the smaller paragraph below the headline
//
// TO CUSTOMIZE per page, pass props when importing:
//   <CTA heading="Custom Heading" subtext="Custom subtext" />
//
// Left side:  heading + subtext
// Right side: phone button (dark) + estimate link (white outline)
// ─────────────────────────────────────────────────────────────────────────────
interface Props {
  heading?: string;
  subtext?: string;
}

const {
  heading = 'Get a Free Landscaping or Excavation Estimate',
  subtext  = 'Call ABCO today for a free estimate on landscaping, excavation, or property maintenance in Eagle Lake and nearby communities.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<section class="cta-section" aria-labelledby="cta-heading">
  <div class="container cta-inner">
    <div class="cta-text">
      <h2 id="cta-heading">{heading}</h2>
      <p>{subtext}</p>
    </div>
    <div class="cta-actions">
      <a href="tel:+17188771197" class="btn btn-primary cta-phone" title="Call ABCO Landscaping and Construction">
        📞 (718) 877-1197
      </a>
      <a href={`${base}contact`} class="btn btn-white-outline" title="Request a free estimate from ABCO Landscaping and Construction">
        Request an Estimate
      </a>
    </div>
  </div>
</section>

<style>
  /* ── Orange CTA banner — all styles scoped to this component only */
  .cta-section {
    background-color: var(--color-orange);
    padding-block: 3.5rem;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-text h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    color: var(--color-white);
    margin-bottom: 0.4rem;
  }

  .cta-text p {
    color: rgba(255, 255, 255, 0.88);
    font-size: 1.1rem;
    max-width: 46ch;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .cta-phone {
    background-color: var(--color-bg);
    color: var(--color-white);
  }
  .cta-phone:hover,
  .cta-phone:focus {
    background-color: var(--color-surface);
    color: var(--color-white);
  }

  /* Local override: on the orange background the white-outline fills white on hover */
  .btn-white-outline {
    background-color: transparent;
    color: var(--color-white);
    border-color: var(--color-white);
  }
  .btn-white-outline:hover,
  .btn-white-outline:focus {
    background-color: var(--color-white);
    color: var(--color-orange);
  }

  @media (max-width: 720px) {
    .cta-inner { flex-direction: column; align-items: flex-start; }
    .cta-actions .btn { width: 100%; text-align: center; }
  }
</style>
