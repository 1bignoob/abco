---
// ─── BaseLayout.astro ─────────────────────────────────────────────────────────
// The master HTML shell used by EVERY page on the site.
// It wraps pages with the full <html>…</html> structure including:
//   • All <head> meta, SEO, OG, and favicon tags
//   • Global CSS import (src/styles/global.css)
//   • Google Analytics (gtag.js)
//   • JSON-LD structured data (passed via `schemaJson` prop)
//   • <Header />, <Breadcrumb />, <Footer /> on every page
//
// HOW PAGES USE IT:
//   <BaseLayout title="..." description="..." schemaJson={mySchema}>
//     ... page content goes here via <slot />
//   </BaseLayout>
//
// PROPS:
//   title       → <title> tag + OG/Twitter title (required)
//   description → meta description + OG/Twitter description (required)
//   image       → OG image path (defaults to og-image-home.webp)
//   imageAlt    → social image alt text for og:image:alt + twitter:image:alt
//   canonical   → canonical URL path e.g. "/services/landscaping/"
//                  (auto-derived from Astro.url.pathname if omitted)
//   noindex     → set true on legal/utility pages to prevent indexing
//   schemaJson  → JSON-LD object from src/lib/schema.ts (injected into <head>)
//   ogType      → Open Graph type (defaults to "website"; use "article" for blog posts)
// ─────────────────────────────────────────────────────────────────────────────
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  schemaJson?: object;
  ogType?: string;
}

const {
  title,
  description,
  image = '/images/og/og-image-home.webp',
  imageAlt,
  canonical,
  noindex = false,
  schemaJson,
  ogType = 'website',
} = Astro.props;

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const siteUrl = 'https://abcoguys.com';
const canonicalUrl = canonical
  ? `${siteUrl}${canonical}`
  : `${siteUrl}${Astro.url.pathname}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const ogImageAlt = imageAlt ?? 'ABCO Landscaping & Construction';
---

<!doctype html>
<html lang="en">
  <head>
    {/* Google Analytics — loads async so it doesn't block rendering */}
    {/* To disable analytics: remove the two <script> blocks below */}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RF80NNQDE5"></script>
    <script
      is:inline
      set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-RF80NNQDE5');
      `}
    />

    {/* Primary meta — edit these per-page via props, not here */}
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />
    <meta name="keywords" content="landscaping, excavation, property maintenance, lawn care, Eagle Lake PA, Gouldsboro PA, Covington Township PA, ABCO Landscaping" />
    <meta name="author" content="ABCO Landscaping & Construction" />
    <meta name="publisher" content="ABCO Landscaping & Construction" />

    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow" />
    }

    <link rel="canonical" href={canonicalUrl} />

    <meta name="theme-color" content="#d95210" />


    <!-- PWA / installed app behavior -->
     <meta name="mobile-web-app-capable" content="yes" />

    <!-- Apple mobile -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ABCO" />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:site_name"   content="ABCO Landscaping & Construction" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:alt"   content={ogImageAlt} />
    <meta property="og:image:width"  content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:locale"      content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <meta name="twitter:image:alt"   content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${import.meta.env.BASE_URL}favicon.svg?v=3`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${import.meta.env.BASE_URL}favicon-96x96.png?v=3`} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico?v=3`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png?v=3`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />

    <!-- Google Font: Montserrat for brand name in nav -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&display=swap" rel="stylesheet" />

    {/* Structured Data — injected from src/lib/schema.ts via schemaJson prop */}
    {/* Each page passes its own schema; this just serializes it to JSON-LD */}
    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}

  </head>
  <body>
    {/* Skip link: lets keyboard/screen-reader users jump past the nav */}
    <a href="#main-content" class="skip-link" title="Skip to main content">Skip to main content</a>
    {/* Header and breadcrumb render on every page automatically */}
    <Header />
    <Breadcrumb />
    {/* Each page's content is injected here via <slot /> */}
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
